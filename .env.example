# Model backend:
#   codex  - send prompts through the Codex CLI (`codex exec`). Needed for gateways such as AgentRouter that only
#            accept approved agent clients. Requires `codex` on PATH.
#   openai - call any OpenAI-compatible HTTP API directly.
LLM_BACKEND=codex
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=your-agentrouter-key
LLM_MODEL=gpt-5.6-sol
# codex backend only: low | medium | high (higher costs more output tokens)
LLM_REASONING_EFFORT=low
# Seconds to wait for one reply
LLM_TIMEOUT_S=600
# USD per million tokens, only used for cost estimates in logs (input measured at ~4 on AgentRouter)
LLM_PRICE_IN_PER_M=4
# LLM_PRICE_OUT_PER_M=

# Cold-viewer judge. Every JUDGE_* value left unset falls back to the LLM_* value.
# JUDGE_MODEL=

# --- Alternative: any OpenAI-compatible HTTP API (e.g. the API Kuku provides at the interview) ---
# LLM_BACKEND=openai
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=...
# Ask for a JSON object via response_format (most OpenAI-compatible APIs support it)
# LLM_JSON_MODE=1
# Seconds between calls, for rate-limited APIs
# LLM_MIN_INTERVAL_S=0
# Sampling temperature (unset = provider default; ignored by the codex backend)
# LLM_TEMPERATURE=0.2

# Experiment tracking (set PROMO_WANDB=0 to run without Weights & Biases)
PROMO_WANDB=1
WANDB_PROJECT=kuku-promo-finder
